{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run validate:footprints && hexo clean && hexo generate && npm run check:site && npm run check:links",
    "build:theme": "npm --prefix themes/journal run build",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "validate:footprints": "node tools/validate-footprints.js",
    "check:site": "node tools/check-site.js",
    "check:links": "node tools/check-links.js",
    "report:media": "node tools/media-report.js"
  },
  "hexo": {
    "version": "5.4.2"
  },
  "dependencies": {
    "hexo": "^5.4.2",
    "hexo-deployer-git": "^3.0.0",
    "hexo-generator-archive": "^1.0.0",
    "hexo-generator-category-enhance": "^0.1.6",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^2.0.0",
    "hexo-generator-tag": "^1.0.0",
    "hexo-renderer-ejs": "1.0.0",
    "hexo-renderer-jade": "^0.5.0",
    "hexo-renderer-marked": "^4.0.0",
    "hexo-renderer-stylus": "^2.0.0",
    "hexo-server": "^2.0.0",
    "hexo-theme-landscape": "^0.0.3"
  }
}
