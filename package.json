{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run validate:footprints && hexo clean && hexo generate && npm run check:site && npm run check:links",
    "build:theme": "npm --prefix themes/journal run build",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "hexo server",
    "validate:footprints": "node tools/validate-footprints.js",
    "check:site": "node tools/check-site.js",
    "check:links": "node tools/check-links.js",
    "report:media": "node tools/media-report.js",
    "check:media:remote": "node tools/check-remote-media.js",
    "report:content": "node tools/content-report.js"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.1.2",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category-enhance": "^0.1.6",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
