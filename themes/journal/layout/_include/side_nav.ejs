<div ref="sideContainer" class="side-container">
    <a class="a-block nav-head <%= is_current('/') && 'active' %>" href="<%= config.root %>">
        <div class="nav-title">
            <%- theme.sidebar_title ? theme.sidebar_title : config.title %>
        </div>
        <div class="nav-subtitle">
            <%- theme.sidebar_subtitle ? theme.sidebar_subtitle : config.subtitle %>
        </div>
    </a>

    <div class="nav-link-list">
        <% if (theme.archives) { %>
        <a class="a-block no-tint nav-link-item <%= is_current('archives') && 'active' %>"
            href="<%= config.root + "archives" %>">
            <%= __('Archive') %>
        </a>
        <% } %>

        <% if(site.pages){ %>
        <% site.pages.each(function (page){ %>
        <% if (page.title && page.path !== 'about/index.html' && page.path !== '404.html') { %>
        <a class="a-block nav-link-item <%= is_current(page.path) && 'active' %>" href="<%= config.root + page.path %>">
            <%= page.title %>
        </a>
        <% } %>
        <% });} %>

        <% if (theme.about) { %>
        <a class="a-block no-tint nav-link-item <%= is_current('about') && 'active' %>"
            href="<%= config.root + "about" %>">
            <%= __('About') %>
        </a>
        <% } %>
        
        <% if (theme.rss) { %>
        <a class="a-block no-tint nav-link-item" href="<%= config.root + theme.rss %>">
            <%= __('RSS') %>
        </a>
        <% } %>
    </div>

    <% // Please keep the section below and do not make modifications. //  %>
    <div class="nav-footer">
        <span>&copy; <%= new Date().getFullYear() %> <a href="<%= config.url %>"><%= config.title %></a></span>
        <button class="theme-toggle theme-toggle-corner" type="button" aria-label="切换深色模式" title="切换深色模式"><i class="material-icons" aria-hidden="true">dark_mode</i></button>
    </div>
</div>
