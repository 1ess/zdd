<link rel="stylesheet" href="<%- versioned_asset('vendor/nord.css') %>">
<link rel="stylesheet" href="<%- versioned_asset('vendor/fonts.css') %>">
<% if (is_post()) { %><link rel="stylesheet" href="<%- versioned_asset('vendor/code-font.css') %>"><% } %>
<link rel="stylesheet" href="<%- versioned_asset('css/journal.css') %>">
<link rel="manifest" href="<%- url_for('manifest.webmanifest') %>">
<meta name="theme-color" content="#f5f3ee">
<% if (theme.favicon || config.favicon){ %>
<link rel="icon" href="<%- config.favicon ? config.favicon : theme.favicon %>">
<% } %>
<script>
    try {
        var savedTheme = localStorage.getItem('color-theme');
        var requestedTheme = new URLSearchParams(location.search).get('theme');
        var useDarkTheme = requestedTheme === 'dark' || (requestedTheme !== 'light' && (savedTheme === 'dark' || (!savedTheme && matchMedia('(prefers-color-scheme: dark)').matches)));
        if (useDarkTheme) document.documentElement.classList.add('dark-theme');
    } catch (error) {}
    (function (d) {
    })(document);
</script>
