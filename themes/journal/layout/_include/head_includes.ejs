<link rel="stylesheet" href="<%- url_for('vendor/bootstrap.min.css') %>">
<link rel="stylesheet" href="<%- url_for('vendor/nord.css') %>">
<link rel="stylesheet" href="<%- url_for('vendor/fonts.css') %>">
<link rel="stylesheet" href="<%- url_for('css/journal.css') %>">
<link rel="manifest" href="<%- url_for('manifest.webmanifest') %>">
<meta name="theme-color" content="#f5f3ee">
<% if (theme.favicon || config.favicon){ %>
<link rel="icon" href="<%- config.favicon ? config.favicon : theme.favicon %>">
<% } %>
<script src="<%- url_for('js/loadCSS.js') %>"></script>
<script>
    try {
        var savedTheme = localStorage.getItem('color-theme');
        if (savedTheme === 'dark' || (!savedTheme && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.classList.add('dark-theme');
    } catch (error) {}
    (function (d) {
    })(document);
</script>
