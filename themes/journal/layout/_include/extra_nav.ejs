<div class="extra-container">
    <div class="pagination">
        <a id="globalBackToTop" class="pagination-action animated-visibility invisible" href="#top" aria-label="返回顶部">
            <svg class="ui-icon pagination-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 15 6-6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <% if(!config.__noPager) { %>
        <% if(page.current && page.total && page.total > 1) { %>
        <div class="pagination-indicator">
            <span style="text-align: center">
                <%= page.current %><br><div style="display: inline-block; transform: rotate(-28deg)">-</div><br><%= page.total %>
            </span>
        </div>
        <% } %>

        <% if (page.prev) { %>
        <a class="pagination-action" href="<%- url_for(page.prev_link) %>">
            <svg class="ui-icon pagination-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <% } %>

        <% if (page.next) { %>
        <a class="pagination-action" href="<%- url_for(page.next_link) %>">
            <svg class="ui-icon pagination-action-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <% } %>
        <% } %>
    </div>
</div>
