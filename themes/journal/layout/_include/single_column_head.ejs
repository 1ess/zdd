<div id="single-column-drawer" class="single-column-drawer-container">
    <div class="drawer-content">
        <div class="drawer-menu">
            <a class="a-block drawer-menu-item <%= is_home() && 'active' %>" href="<%= config.url %>"><%= __('Home') %></a>
            <% if (theme.archives) { %><a class="a-block drawer-menu-item <%= is_current('archives') && 'active' %>" href="<%= config.root + 'archives' %>"><%= __('Archive') %></a><% } %>
            <% if(site.pages){ site.pages.each(function (page){ if (page.title && page.path !== '404.html') { %>
            <a class="a-block drawer-menu-item <%= is_current(page.path) && 'active' %>" href="<%= config.root + page.path %>"><%= page.title %></a>
            <% } }); } %>
            <% if (theme.rss) { %><a class="a-block drawer-menu-item" href="<%= config.root + theme.rss %>"><%= __('RSS') %></a><% } %>
        </div>
        <button class="theme-toggle drawer-theme-corner" type="button" aria-label="切换深色模式" title="切换深色模式"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.4A8 8 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z" fill="currentColor"/></svg></button>
    </div>
</div>
<div id="single-column-drawer-mask" class="single-column-drawer-mask"></div>
<nav id="single-column-nav" class="single-column-nav-container">
    <div id="single-column-nav-background" class="nav-background"></div>
    <div class="container-narrow nav-content">
        <button id="nav_dropdown_btn" class="nav-dropdown-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="single-column-drawer"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
        <a id="single-column-nav-title" class="navbar-brand" href="<%= config.root %>"><%= config.title %></a>
        <button class="theme-toggle theme-toggle-mobile" type="button" aria-label="切换深色模式" title="切换深色模式"><svg class="ui-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.4A8 8 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z" fill="currentColor"/></svg></button>
    </div>
</nav>
<div id="single-column-page-head" class="single-column-header-container">
    <a href="<%= config.root %>"><div class="single-column-header-title"><%= config.title %></div><div class="single-column-header-subtitle"><%= config.description %></div></a>
</div>
